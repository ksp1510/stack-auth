---
// apps/astro-js/src/pages/home.astro
import "../styles.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Home · Astro (JS)</title>
  </head>

  <body>
    <main class="app">
      <section class="card wide">
        <header class="head">
          <div>
            <div class="title">Home</div>
            <div class="sub">Astro (JS) · Authenticated area</div>
          </div>

          <button id="logout" class="btn" type="button">Logout</button>
        </header>

        <div id="loading" class="small">Loading...</div>

        <div id="content" hidden>
          <div class="grid">
            <div class="box">
              <div class="k">Authenticated</div>
              <div class="v">Yes</div>
            </div>
            <div class="box">
              <div class="k">User</div>
              <div id="userLabel" class="v">—</div>
            </div>
          </div>

          <div class="panel">
            <div class="panelTitle">Profile JSON</div>
            <pre id="profileJson">{}</pre>
          </div>

          <a class="link" href="http://localhost:3000/" style="display:inline-block; margin-top:12px;">
            Back to landing
          </a>
        </div>
      </section>
    </main>

    <script type="module" src="/src/client/home.js"></script>
  </body>
</html>